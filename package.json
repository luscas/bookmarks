{
  "name": "bookmarks",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @bookmarks/db db:generate",
    "db:migrate:local": "pnpm --filter @bookmarks/server exec wrangler d1 migrations apply bookmarks --local",
    "db:migrate:remote": "pnpm --filter @bookmarks/server exec wrangler d1 migrations apply bookmarks --remote"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "tinypool": ">=2.1.2"
    }
  }
}
