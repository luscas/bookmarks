{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookmarks",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Non-secret vars live in `.dev.vars` locally (generated by `just env`) and
  // in the dashboard / `wrangler secret put` for deploys — keeping dev values
  // out of the shipped config.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookmarks",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FAVICONS",
      "bucket_name": "bookmarks-favicons"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_QUEUE",
        "queue": "bookmarks-ai"
      }
    ],
    "consumers": [
      {
        "queue": "bookmarks-ai",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "bookmarks-ai-dlq"
      }
    ]
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Route every request through the Worker so security headers (CSP,
    // nosniff, frame-ancestors, …) apply to asset responses too. Without
    // this, the assets layer serves matches before the Worker runs.
    "run_worker_first": true
  }
}
